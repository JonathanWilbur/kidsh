# Maintainer: Jonathan M. Wilbur <jonathan@wilbur.space>
pkgname=kidsh
pkgver=1.0.0
pkgrel=1
pkgdesc="A lightweight secure shell for young children"
arch=('x86_64' 'aarch64' 'riscv64')
url="https://github.com/JonathanWilbur/kidsh"
license=('MIT')
depends=('glibc')
makedepends=('go')
options=(!debug !strip)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=1
  export GOARCH="${GOARCH:-$(go env GOHOSTARCH)}"
  go build -trimpath -ldflags "-s -w -X main.version=$pkgver" -o kidsh ./src
}

check() {
  cd "$pkgname-$pkgver"
  native="$(go env GOHOSTARCH)"
  # Cross builds leave CC set to *-linux-gnu-gcc. go test for the host arch
  # (amd64) injects -m64, which aarch64/riscv64 gcc reject.
  CGO_ENABLED=1 CC=gcc GOARCH="$native" go test ./...
  if [ "$(go env GOARCH)" = "$native" ]; then
    ./kidsh -version
  fi
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 kidsh "$pkgdir/usr/bin/kidsh"
  install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 packaging/kidsh.json.example "$pkgdir/usr/share/doc/$pkgname/kidsh.json.example"
  install -Dm644 man/kidsh.1 "$pkgdir/usr/share/man/man1/kidsh.1"
}
