#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

export CGO_ENABLED = 0
export GO111MODULE = on
export GOOS = linux
export GOARCH = $(DEB_HOST_ARCH)

VERSION := $(shell dpkg-parsechangelog -S Version | cut -d- -f1)

%:
	dh $@

override_dh_auto_clean:
	rm -f kidsh

override_dh_auto_build:
	go build -trimpath -ldflags "-s -w -X main.version=$(VERSION)" -o kidsh ./src

override_dh_auto_test:
	GOARCH=$(DEB_BUILD_ARCH) go test ./...
ifneq ($(DEB_BUILD_ARCH),$(DEB_HOST_ARCH))
	@echo "skipping target binary smoke test on cross-build ($(DEB_HOST_ARCH))"
else
	./kidsh -version
endif

override_dh_auto_install:
	install -D -m 755 kidsh debian/kidsh/usr/bin/kidsh

override_dh_dwz:
	# Skip dwz compression for Go binaries

override_dh_strip:
	# Go binary is already stripped via -ldflags -s -w

override_dh_makeshlibs:
	# Static Go binary; no shared libraries. Cross-builds also lack
	# ${DEB_HOST_GNU_TYPE}-objdump (e.g. aarch64-linux-gnu-objdump).

override_dh_shlibdeps:
	# Static Go binary; no shlibs:Depends
